# Neo4j connection (used by the Tauri app via neo4rs and by the Graphiti MCP)
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional local-only overrides. The defaults bind Neo4j to localhost and keep
# data in named Docker volumes. Do not change the bind address to 0.0.0.0.
RESEARCH_CANVAS_NEO4J_HTTP_PORT=17474
RESEARCH_CANVAS_NEO4J_BOLT_PORT=17687
RESEARCH_CANVAS_NEO4J_VOLUME=antichristproject_neo4j_data
RESEARCH_CANVAS_NEO4J_LOGS_VOLUME=antichristproject_neo4j_logs

# Graphiti MCP only (theory authoring agent)
GOOGLE_API_KEY=
GRAPHITI_LLM_MODEL=gemini-2.5-flash
GRAPHITI_EMBEDDER_MODEL=gemini-embedding-001
GRAPHITI_RERANKER_MODEL=gemini-2.5-flash-lite
