{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Canvas",
  "version": "0.1.0",
  "identifier": "com.antichristproject.researchcanvas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "pnpm --filter @research-canvas/desktop dev --host 127.0.0.1 --port 4173",
    "beforeBuildCommand": "pnpm --filter @research-canvas/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Research Canvas",
        "width": 1520,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

